# ───────── MyRepairUnder100 API ─────────
# Copy to .env and fill in. NEVER commit real secrets.
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Used in referral links: https://<domain>/ref/<CODE>
WEB_BASE_URL=https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mru
DATABASE_SSL=false

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ADMIN_SECRET=
OTP_HASH_SECRET=
FILE_URL_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ── OTP / SMS ──  mock | msg91 | twilio   (mock is refused when NODE_ENV=production)
SMS_PROVIDER=mock
# DEV ONLY: returns the OTP in the /auth/send-otp response so you can log in locally
OTP_DEV_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Payments ──  mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Maps ──  mock | google   (server-side key; restrict it to Geocoding, Places, Distance Matrix)
MAPS_PROVIDER=mock
GOOGLE_MAPS_SERVER_KEY=

# ── Push ──  log | expo
PUSH_PROVIDER=log
EXPO_ACCESS_TOKEN=

# ── File storage ──  local | s3  (S3, Cloudflare R2, DigitalOcean Spaces, MinIO…)
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Run background jobs (offer expiry, unpaid-booking expiry, promo expiry) in this process
RUN_JOBS=true
LOG_LEVEL=info

# First admin for production seeding (dev seeding creates admin@myrepairunder100.local)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
